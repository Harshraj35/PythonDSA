# Using iterative approach
# Function defination
def findfactorial(n):
    # Base case condition
    # Smalll problem
    if n ==0 or n ==1:
        return 1
    else:
        # Big problem
        result = 1
        for i in range(2, n + 1):
            result = result * i
        return result

# Driver code
n = 8      
# Calling the function
result = findfactorial(n)         
print("Factorial of", n, "is", result)    